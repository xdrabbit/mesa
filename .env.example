# Copy to .env (git-ignored). NEVER commit real values — this repo is public.
# Bot token: create/revoke via @BotFather on Telegram (/mybots -> API Token).
TELEGRAM_BOT_TOKEN=your-bot-token-here
# The only chat the bot will answer, and where cron alerts are sent. Message your bot, then
# open https://api.telegram.org/bot<TOKEN>/getUpdates to read "chat":{"id":...}.
TELEGRAM_CHAT_ID=your-chat-id-here
